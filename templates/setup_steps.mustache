{{!
    @template auth_moowoodle/setup_steps

    Setup wizard step indicator.

    Context variables required for this template:
    * steps - array of {number, title, active, completed}
}}
<ol class="list-group list-group-horizontal mb-4 flex-wrap">
    {{#steps}}
        <li class="list-group-item {{#active}}active{{/active}} {{#completed}}list-group-item-success{{/completed}}">
            <strong>{{number}}.</strong> {{title}}
        </li>
    {{/steps}}
</ol>
